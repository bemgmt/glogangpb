# Supabase (glogangdb project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# Sanity (GloGang project)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-token

# OpenAI (AI search embeddings)
OPENAI_API_KEY=sk-your-key

# Resend (transactional email)
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=noreply@glogangworldwide.com

# Stripe (scaffolded — not required for initial launch)
STRIPE_SECRET_KEY=sk_test_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# App
NEXT_PUBLIC_SITE_URL=https://glogangworldwide.com
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://shop.glogangworldwide.com
